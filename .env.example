# Copy this file to .env and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The password typed on the front door of the site.
VITE_SITE_PASSWORD=cold

# Giphy API key, used by the /api/gifs server function.
# No VITE_ prefix on purpose: that keeps it on the server instead of baking it
# into the JavaScript bundle where anyone could read it. On Vercel, set this in
# Project Settings -> Environment Variables, NOT here.
GIPHY_KEY=
